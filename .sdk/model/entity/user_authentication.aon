# Entity: user_authentication

main: kit: entity: user_authentication: {

  alias: field: {}

  fields: [
    {
      name: "email"
      req: true
      type: "`$STRING`"
    }
    {
      name: "new_password"
      req: true
      type: "`$STRING`"
    }
    {
      name: "token"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "user_authentication"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/v1/auth/begin-reset-password"
          parts: [
            "api"
            "v1"
            "auth"
            "begin-reset-password"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/api/v1/auth/logout"
          parts: [
            "api"
            "v1"
            "auth"
            "logout"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/api/v1/auth/password"
          parts: [
            "api"
            "v1"
            "auth"
            "password"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/api/v1/auth/reset-password"
          parts: [
            "api"
            "v1"
            "auth"
            "reset-password"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/api/v1/auth/verify-email"
          parts: [
            "api"
            "v1"
            "auth"
            "verify-email"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

# Entity: login

main: kit: entity: login: {

  alias: field: {}

  fields: {
    email: {
      h: "Email"
      n: "email"
      r: true
      t: "`$STRING`"
    }
    password: {
      h: "Password"
      n: "password"
      r: true
      t: "`$STRING`"
    }
  }

  name: "login"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "email"
            "password"
          ]
          co: {
            id: "POST /api/v1/auth/login"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/v1/auth/login"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "auth"
            }
            {
              lit: "login"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /api/v1/auth/refresh"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/v1/auth/refresh"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "auth"
            }
            {
              lit: "refresh"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

# Entity: error

main: kit: entity: error: {

  alias: field: {}

  fields: {
    detail: {
      h: "Detail"
      n: "detail"
      r: true
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Identifier of the problem that occurred, stable across releases"
      t: "`$STRING`"
    }
    status: {
      fo: "int32"
      h: "Status"
      n: "status"
      r: true
      t: "`$INTEGER`"
    }
    title: {
      h: "Title"
      n: "title"
      r: true
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      sh: "Documentation page of this problem, which is also what distinguishes one problem type from another as RFC 7807 asks."
      t: "`$STRING`"
    }
    validation: {
      h: "Validation"
      n: "validation"
      r: false
      sh: "Which submitted values were rejected and why, keyed by the name of the field they were submitted under."
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "error"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/v1/errors/"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/api/v1/errors/"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "errors"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

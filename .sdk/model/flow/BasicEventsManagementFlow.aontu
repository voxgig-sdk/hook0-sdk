# BasicEventsManagementFlow

main: kit: flow: BasicEventsManagementFlow:
{
  entity: "events_management",
  kind: "basic",
  name: "BasicEventsManagementFlow",
  step: [
    {
      input: {
        ref: "events_management_ref01"
      }

      match: {
        event_id: "event01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "events_management_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "events_management_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "events_management01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "events_management_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEventsManagementFlow"
}
# BasicEventTypeFlow

main: kit: flow: BasicEventTypeFlow:
{
  entity: "event_type",
  kind: "basic",
  name: "BasicEventTypeFlow",
  step: [
    {
      input: {
        ref: "event_type_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "event_type_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "event_type_ref01",
        srcdatavar: "event_type_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "event_type01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-event_type_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEventTypeFlow"
}
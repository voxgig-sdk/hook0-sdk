# BasicSubscriptionFlow

main: kit: flow: BasicSubscriptionFlow:
{
  entity: "subscription",
  kind: "basic",
  name: "BasicSubscriptionFlow",
  step: [
    {
      input: {
        ref: "subscription_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "subscription_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "subscription_ref01",
        srcdatavar: "subscription_ref01_data",
        suffix: "_up0",
        textfield: "application_id"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-subscription_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "subscription_ref01",
        srcdatavar: "subscription_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "subscription01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-subscription_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "subscription_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "subscription01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "subscription_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSubscriptionFlow"
}
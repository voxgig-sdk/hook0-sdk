# BasicServiceTokenFlow

main: kit: flow: BasicServiceTokenFlow:
{
  entity: "service_token",
  kind: "basic",
  name: "BasicServiceTokenFlow",
  step: [
    {
      i: {
        ref: "service_token_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "service_token_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "service_token_ref01",
        srcdatavar: "service_token_ref01_data",
        suffix: "_up0",
        textfield: "biscuit"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-service_token_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "service_token_ref01",
        srcdatavar: "service_token_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "service_token01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-service_token_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "service_token_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "service_token01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "service_token_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicServiceTokenFlow"
}
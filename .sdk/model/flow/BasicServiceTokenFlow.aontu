# BasicServiceTokenFlow

main: kit: flow: BasicServiceTokenFlow:
{
  entity: "service_token",
  kind: "basic",
  name: "BasicServiceTokenFlow",
  step: [
    {
      input: {
        ref: "service_token_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "service_token_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "service_token_ref01",
        srcdatavar: "service_token_ref01_data",
        suffix: "_up0",
        textfield: "biscuit"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-service_token_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "service_token_ref01",
        srcdatavar: "service_token_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "service_token01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-service_token_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "service_token_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "service_token01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "service_token_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicServiceTokenFlow"
}